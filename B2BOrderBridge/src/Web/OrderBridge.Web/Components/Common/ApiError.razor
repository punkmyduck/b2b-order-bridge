@if (Error is not null)
{
    <div class="error-banner" role="alert">
        <strong>@Error.Message</strong>
        @if (!string.IsNullOrWhiteSpace(Error.Detail)) { <p>@Error.Detail</p> }
        @if (Error.Errors.Count > 0)
        {
            <ul>@foreach (var error in Error.Errors) { @foreach (var message in error.Value) { <li><span class="muted">@error.Key:</span> @message</li> } }</ul>
        }
        @if (Error.TraceId is not null) { <small>Код обращения: <code>@Error.TraceId</code></small> }
    </div>
}
@code { [Parameter] public ApiException? Error { get; set; } }

