@page "/orders/new"
@inject OrderBridgeApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Создать заказ · OrderBridge</PageTitle>
<a class="back-link" href="/"><Icon Name="back" />Все заказы</a>
<div class="page-heading"><div><span class="eyebrow">НОВЫЙ ЗАКАЗ</span><h1>Создать заказ</h1><p>Укажите данные клиента и позиции. Интеграции запустятся автоматически.</p></div></div>
<ApiError Error="_error" />
<EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="create-order">
    <DataAnnotationsValidator />
    <ValidationSummary class="validation-summary" />
    <fieldset disabled="@_saving" class="form-fieldset">
        <div class="create-grid">
            <div class="form-sections">
                <section class="panel form-panel"><div class="section-heading"><span class="step-number">01</span><div><h2>Данные заказа</h2><p>Источник и номер связывают заказ с внешней системой.</p></div></div>
                    <div class="field-grid"><div class="field"><label for="source">Источник <span>*</span></label><InputText id="source" @bind-Value="_model.SourceSystem" maxlength="64" placeholder="Например, Marketplace" /><ValidationMessage For="() => _model.SourceSystem" /></div><div class="field"><label for="external-id">Внешний номер <span>*</span></label><InputText id="external-id" @bind-Value="_model.ExternalOrderId" maxlength="512" placeholder="Например, ORD-00421" /><ValidationMessage For="() => _model.ExternalOrderId" /></div></div>
                </section>
                <section class="panel form-panel"><div class="section-heading"><span class="step-number">02</span><div><h2>Клиент</h2><p>Реквизиты компании и контакт для связи.</p></div></div>
                    <div class="field"><label for="company">Название компании <span>*</span></label><InputText id="company" @bind-Value="_model.CompanyName" maxlength="128" placeholder="ООО «Компания»" /><ValidationMessage For="() => _model.CompanyName" /></div>
                    <div class="field-grid"><div class="field"><label for="tax-id">ИНН <span>*</span></label><InputText id="tax-id" @bind-Value="_model.TaxId" maxlength="512" /><ValidationMessage For="() => _model.TaxId" /></div><div class="field"><label for="email">Email <span>*</span></label><InputText id="email" type="email" @bind-Value="_model.ContactEmail" maxlength="256" placeholder="orders@company.ru" /><ValidationMessage For="() => _model.ContactEmail" /></div></div>
                </section>
                <section class="panel form-panel"><div class="section-heading"><span class="step-number">03</span><div><h2>Позиции заказа</h2><p>Количество и цена за единицу в выбранной валюте.</p></div></div>
                    @for (var i = 0; i < _model.Lines.Count; i++)
                    {
                        var line = _model.Lines[i]; var index = i;
                        <div class="line-form" @key="line"><div class="line-heading"><strong>Позиция @(i + 1)</strong><button type="button" class="button icon-button ghost" aria-label="@($"Удалить позицию {i + 1}")" disabled="@(_model.Lines.Count == 1)" @onclick="() => _model.Lines.RemoveAt(index)"><Icon Name="trash" /></button></div>
                            <div class="field-grid"><div class="field"><label for="@($"sku-{i}")">Артикул <span>*</span></label><InputText id="@($"sku-{i}")" @bind-Value="line.Sku" maxlength="128" placeholder="SKU-001" /></div><div class="field"><label for="@($"name-{i}")">Название <span>*</span></label><InputText id="@($"name-{i}")" @bind-Value="line.Name" maxlength="128" placeholder="Название товара или услуги" /></div></div>
                            <div class="field-grid"><div class="field"><label for="@($"qty-{i}")">Количество <span>*</span></label><InputNumber id="@($"qty-{i}")" @bind-Value="line.Quantity" step="any" /></div><div class="field"><label for="@($"price-{i}")">Цена за единицу <span>*</span></label><InputNumber id="@($"price-{i}")" @bind-Value="line.UnitPrice" step="0.01" /></div></div>
                        </div>
                    }
                    <button type="button" class="button secondary" @onclick="() => _model.Lines.Add(new())"><Icon Name="plus" />Добавить позицию</button>
                </section>
            </div>
            <aside class="panel order-summary"><span class="eyebrow">ИТОГО</span><h2>Ваш заказ</h2><div class="field"><label for="currency">Валюта</label><InputSelect id="currency" @bind-Value="_model.Currency">@foreach (var currency in CreateOrderForm.Currencies) { <option value="@currency">@currency</option> }</InputSelect></div><div class="summary-row"><span>Позиций</span><strong>@_model.Lines.Count</strong></div><div class="summary-total">@(_model.Total is { } total ? Display.Money(total, _model.Currency) : "Сумма слишком велика")</div><p class="muted">После сохранения откроется карточка заказа со статусами интеграций.</p><button type="submit" class="button primary full-width" disabled="@_saving">@if (_saving) { <span class="loader small-loader"></span> } else { <Icon Name="plus" /> }@(_saving ? "Сохраняем…" : "Создать заказ")</button><a class="cancel-link" href="/">Отмена</a></aside>
        </div>
    </fieldset>
</EditForm>

@code {
    private readonly CreateOrderForm _model = new();
    private readonly CancellationTokenSource _lifetime = new();
    private ApiException? _error;
    private bool _saving;
    private async Task SubmitAsync()
    {
        if (_saving) return;
        _saving = true; _error = null;
        try
        {
            var created = await Api.CreateOrderAsync(_model.ToInput(), _lifetime.Token);
            Navigation.NavigateTo($"/orders/{created.Id}?created=true");
        }
        catch (ApiException ex) { _error = ex; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _saving = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}

