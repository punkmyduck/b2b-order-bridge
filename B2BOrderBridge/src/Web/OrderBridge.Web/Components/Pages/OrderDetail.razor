@page "/orders/{Id:guid}"
@inject OrderBridgeApiClient Api
@implements IDisposable

<PageTitle>@(_order is null ? "Заказ" : $"Заказ {_order.ExternalOrderId}") · OrderBridge</PageTitle>
<a class="back-link" href="/"><Icon Name="back" />Все заказы</a>
<ApiError Error="_error" />
@if (_order is null)
{
    <section class="panel empty-state">
        @if (_busy) { <span class="loader"></span><h1>Загружаем заказ</h1> }
        else { <h1>Заказ недоступен</h1><p>Проверьте ссылку или повторите запрос.</p><button class="button secondary" @onclick="LoadAsync">Повторить</button> }
    </section>
}
else
{
    @if (Created) { <div class="success-banner" role="status">Заказ создан. Обновите карточку, чтобы увидеть результат фоновой обработки.</div> }
    <div class="page-heading"><div><span class="eyebrow">КАРТОЧКА ЗАКАЗА</span><h1>Заказ @_order.ExternalOrderId</h1><p>@_order.SourceSystem <span class="inline-separator">·</span> Создан @Display.Date(_order.CreatedAt)</p></div><button class="button secondary" disabled="@_busy" @onclick="LoadAsync"><Icon Name="refresh" />@(_busy ? "Обновляем…" : "Обновить")</button></div>
    <div class="order-overview">
        <section class="panel overview-company"><span class="eyebrow">КЛИЕНТ</span><h2>@_order.Customer.CompanyName</h2><dl><div><dt>ИНН</dt><dd>@_order.Customer.TaxId</dd></div><div><dt>Email</dt><dd>@_order.Customer.ContactEmail</dd></div></dl></section>
        <section class="panel overview-status"><span class="eyebrow">СОСТОЯНИЕ</span><dl><div><dt>Заказ</dt><dd><StatusBadge Value="@_order.OrderStatus" /></dd></div><div><dt>Оплата</dt><dd><StatusBadge Value="@_order.PaymentStatus" /></dd></div></dl></section>
        <section class="panel overview-total"><span class="eyebrow">СУММА ЗАКАЗА</span><div class="summary-total">@Display.Money(_order.TotalAmount, _order.Currency)</div><p class="muted">Позиций: @_order.Lines.Count</p></section>
    </div>
    <section class="panel positions-panel"><div class="panel-header"><div><h2>Позиции заказа</h2><p>Состав и стоимость</p></div><span class="count-pill">@_order.Lines.Count</span></div><div class="table-scroll"><table><thead><tr><th>Товар / услуга</th><th>Артикул</th><th class="align-right">Количество</th><th class="align-right">Цена</th><th class="align-right">Сумма</th></tr></thead><tbody>@foreach (var line in _order.Lines) { <tr><td><strong>@line.Name</strong></td><td class="muted">@line.Sku</td><td class="align-right">@Display.Number(line.Quantity)</td><td class="align-right money">@Display.Money(line.UnitPrice, _order.Currency)</td><td class="align-right money">@Display.Money(line.LineTotal, _order.Currency)</td></tr> }</tbody></table></div></section>
    <section class="integrations-section"><div class="section-title"><div><h2>Интеграции</h2><p>Статусы отправки и история выполнения</p></div><span class="count-pill">@_order.Integrations.Count</span></div>
        @if (!_order.IntegrationsAvailable)
        {
            <div class="error-banner" role="alert">Сервис интеграций временно недоступен. Данные заказа загружены. Обновите карточку, чтобы получить статусы.</div>
        }
        else if (_order.Integrations.Count == 0) { <div class="panel empty-state"><h3>Интеграций пока нет</h3><p>Планирование выполняется асинхронно. Обновите карточку через несколько секунд.</p></div> }
        @foreach (var integration in _order.Integrations)
        {
            var expanded = _expanded.Contains(integration.Id);
            <article class="panel integration-card" @key="integration.Id"><div class="integration-main"><span class="integration-logo">@(integration.IntegrationTarget == "Telegram" ? "↗" : Display.Target(integration.IntegrationTarget)[..1])</span><div class="integration-name"><h3>@Display.Target(integration.IntegrationTarget)</h3><p>@Display.Operation(integration.IntegrationOperation)</p></div><StatusBadge Value="@integration.IntegrationStatus" /></div>
                <dl class="integration-meta"><div><dt>Попыток</dt><dd>@integration.AttemptCount</dd></div><div><dt>Внешний ID</dt><dd class="mono">@(integration.ExternalEntityId ?? "—")</dd></div><div><dt>Последняя попытка</dt><dd>@Display.Date(integration.LastAttemptAt)</dd></div><div><dt>Завершена</dt><dd>@Display.Date(integration.CompletedAt)</dd></div></dl>
                @if (integration.NextAttemptAt is not null) { <p class="schedule-note">Следующая попытка: @Display.Date(integration.NextAttemptAt)</p> }
                @if (integration.LastErrorMessage is not null) { <div class="integration-error"><strong>@integration.LastErrorCode</strong><span>@integration.LastErrorMessage</span></div> }
                <div class="integration-footer"><button class="text-button" aria-expanded="@expanded" @onclick="() => Toggle(integration.Id)">@(expanded ? "Скрыть историю" : "История попыток") <span>@(expanded ? "↑" : "↓")</span></button><details class="technical-details"><summary>Технические данные</summary><dl><div><dt>ID интеграции</dt><dd><code>@integration.Id</code></dd></div><div><dt>Ключ идемпотентности</dt><dd><code>@integration.IdempotencyKey</code></dd></div></dl></details></div>
                @if (expanded) { <AttemptHistory IntegrationId="integration.Id" ReloadVersion="_reloadVersion" /> }
            </article>
        }
    </section>
    <details class="panel order-technical"><summary>Технические данные заказа</summary><dl><div><dt>ID заказа</dt><dd><code>@_order.Id</code></dd></div><div><dt>Последнее изменение</dt><dd>@Display.Date(_order.UpdatedAt)</dd></div></dl></details>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public bool Created { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly HashSet<Guid> _expanded = [];
    private OrderDetails? _order;
    private ApiException? _error;
    private bool _busy;
    private int _reloadVersion;
    private Guid _loadedId;
    private int _requestVersion;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id; _order = null; _expanded.Clear();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_requestVersion;
        var id = Id;
        _busy = true; _error = null;
        try
        {
            var order = await Api.GetOrderAsync(id, _lifetime.Token);
            if (version != _requestVersion) return;
            _order = order; _reloadVersion++;
        }
        catch (ApiException ex) { if (version == _requestVersion) _error = ex; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { if (version == _requestVersion) _busy = false; }
    }
    private void Toggle(Guid id) { if (!_expanded.Add(id)) _expanded.Remove(id); }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}

