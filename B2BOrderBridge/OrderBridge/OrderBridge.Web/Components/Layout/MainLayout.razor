@inherits LayoutComponentBase
<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="OrderBridge — главная"><span class="brand-mark"><Icon Name="layers" /></span><span>OrderBridge<span class="brand-caption">INTEGRATION WORKSPACE</span></span></a>
        <div class="workspace"><span class="workspace-avatar">B</span><div><strong>B2B Workspace</strong><small>Управление заказами</small></div></div>
        <p class="nav-caption">РАБОЧЕЕ ПРОСТРАНСТВО</p>
        <nav aria-label="Основная навигация">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="orders" />Заказы</NavLink>
            <NavLink href="/orders/new"><Icon Name="plus" />Создать заказ</NavLink>
        </nav>
        <div class="sidebar-bottom"><span class="avatar">OB</span><div><strong>OrderBridge</strong><small>Демонстрационный проект</small></div></div>
    </aside>
    <div class="main-shell">
        <header class="topbar"><span>Рабочее пространство <span class="breadcrumb-separator">/</span> <strong>Заказы</strong></span><span class="workspace-tag">B2B</span></header>
        <main id="main-content">@Body</main>
        <footer class="page-footer"><span>OrderBridge · Управление интеграциями</span><span>Время в интерфейсе — UTC</span></footer>
    </div>
</div>
<div id="blazor-error-ui" role="alert">Соединение прервано. <a href="." class="reload">Перезагрузить страницу</a><a class="dismiss" aria-label="Закрыть">×</a></div>

