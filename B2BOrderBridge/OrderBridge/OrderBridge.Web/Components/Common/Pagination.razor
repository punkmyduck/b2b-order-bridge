<div class="pagination">
    <span class="muted">@RangeText</span>
    <div class="pagination-controls">
        <button class="button secondary small" disabled="@(Busy || PageNumber <= 1)" @onclick="() => PageChanged.InvokeAsync(PageNumber - 1)" aria-label="Предыдущая страница">←</button>
        <span>Страница @PageNumber из @Math.Max(1, TotalPages)</span>
        <button class="button secondary small" disabled="@(Busy || PageNumber >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(PageNumber + 1)" aria-label="Следующая страница">→</button>
    </div>
</div>
@code {
    [Parameter] public int PageNumber { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public long TotalPages { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    private string RangeText => TotalCount == 0 ? "Нет записей" : $"{Math.Min((PageNumber - 1L) * PageSize + 1, TotalCount)}–{Math.Min(PageNumber * (long)PageSize, TotalCount)} из {TotalCount}";
}

