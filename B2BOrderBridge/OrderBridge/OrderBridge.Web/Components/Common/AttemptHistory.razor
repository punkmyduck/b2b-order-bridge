@inject OrderBridgeApiClient Api
@implements IDisposable

<div class="attempt-history">
    <ApiError Error="_error" />
    @if (_busy) { <p class="loading-inline" role="status"><span class="loader small-loader"></span>Загружаем историю…</p> }
    else if (_error is not null) { <button class="button secondary small" @onclick="LoadAsync">Повторить загрузку</button> }
    else if (_page is null || _page.Items.Count == 0) { <p class="muted">Попыток пока нет. Интеграция ещё не запускалась.</p> }
    else
    {
        @foreach (var attempt in _page.Items)
        {
            <div class="attempt" @key="attempt.Id"><div class="attempt-heading"><strong>Попытка #@attempt.AttemptNumber</strong><StatusBadge Value="@attempt.Outcome" /></div><dl class="attempt-meta"><div><dt>Начало</dt><dd>@Display.Date(attempt.StartedAt)</dd></div><div><dt>Завершение</dt><dd>@Display.Date(attempt.CompletedAt)</dd></div><div><dt>HTTP</dt><dd>@(attempt.ResponseStatusCode?.ToString() ?? "—")</dd></div></dl>
                @if (attempt.ErrorMessage is not null) { <div class="integration-error"><strong>@attempt.ErrorCode</strong><span>@attempt.ErrorMessage</span></div> }
                @if (attempt.TraceId is not null) { <p class="trace-id">Trace ID <code>@attempt.TraceId</code></p> }
            </div>
        }
        <Pagination PageNumber="_page.PageNumber" PageSize="_page.PageSize" TotalCount="_page.TotalCount" TotalPages="_page.TotalPages" Busy="_busy" PageChanged="ChangePageAsync" />
    }
</div>
@code {
    [Parameter] public Guid IntegrationId { get; set; }
    [Parameter] public int ReloadVersion { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private PageResult<Attempt>? _page;
    private ApiException? _error;
    private bool _busy;
    private int _pageNumber = 1, _loadedVersion = -1, _requestVersion;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedVersion == ReloadVersion) return;
        _loadedVersion = ReloadVersion;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_requestVersion;
        _busy = true; _error = null;
        try
        {
            var page = await Api.GetAttemptsAsync(IntegrationId, _pageNumber, _lifetime.Token);
            if (version == _requestVersion) _page = page;
        }
        catch (ApiException ex) { if (version == _requestVersion) _error = ex; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { if (version == _requestVersion) _busy = false; }
    }
    private Task ChangePageAsync(int page) { _pageNumber = page; return LoadAsync(); }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}

